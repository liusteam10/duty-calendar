.page { padding: 24rpx; }
.hero-card { padding: 30rpx; color: #fff; border-radius: 30rpx; background: #0c1f3d; box-shadow: 0 20rpx 50rpx rgba(12,31,61,.18); }
.eyebrow { color: #9db3d4; font-size: 19rpx; letter-spacing: 2rpx; }
.hero-title { margin-top: 38rpx; font-size: 39rpx; font-weight: 800; }
.hero-date { margin-top: 18rpx; color: #e1f8f1; font-size: 27rpx; font-weight: 700; }
.hero-meta { margin-top: 10rpx; color: #b9c9df; font-size: 21rpx; }
.section-head { display: flex; justify-content: space-between; align-items: center; margin: 35rpx 2rpx 17rpx; font-size: 29rpx; font-weight: 800; }
.muted { color: #748197; font-size: 20rpx; font-weight: 400; }
.week-row, .calendar-grid { display: grid; grid-template-columns: repeat(7, 1fr); gap: 8rpx; }
.week-row { color: #748197; text-align: center; font-size: 19rpx; margin-bottom: 8rpx; }
.day-card { min-height: 150rpx; padding: 10rpx 8rpx; border: 1rpx solid #e5eaf1; border-radius: 15rpx; background: #fff; }
.day-card.selected { border: 3rpx solid #3b82f6; background: #f2f7ff; }
.day-number { display: block; margin-bottom: 8rpx; font-size: 23rpx; font-weight: 800; }
.count { display: block; margin-top: 6rpx; padding: 4rpx 5rpx; border-radius: 5rpx; font-size: 16rpx; }
.leader, .tag.leader { color: #6740b8; background: #f2edff; } .day, .tag.day { color: #2764c6; background: #eaf2ff; } .night, .tag.night { color: #13856e; background: #e9faf5; }
.detail-card { padding: 2rpx 24rpx 23rpx; margin-top: 24rpx; border-radius: 22rpx; background: #fff; }
.detail-row { display: flex; align-items: center; gap: 16rpx; padding: 22rpx 0; border-bottom: 1rpx solid #eef1f5; font-size: 23rpx; }
.detail-row:last-child { border-bottom: 0; } .detail-row .muted { margin-left: auto; }
.tag { padding: 7rpx 10rpx; border-radius: 7rpx; font-size: 17rpx; }
