.page { padding: 35rpx 28rpx; } .profile-card { display: flex; align-items: center; gap: 22rpx; padding: 30rpx; border-radius: 24rpx; color: #fff; background: #0c1f3d; } .avatar { width: 82rpx; height: 82rpx; border-radius: 50%; display: grid; place-items: center; color: #57370f; background: #f4c37b; font-size: 30rpx; font-weight: 800; } .name { font-size: 32rpx; font-weight: 800; } .sub { margin-top: 8rpx; color: #b9c9df; font-size: 20rpx; } .section { margin-top: 32rpx; padding: 25rpx; border-radius: 22rpx; background: #fff; } .section-title { color: #15233b; font-size: 26rpx; font-weight: 800; } .stats { display: grid; grid-template-columns: repeat(3, 1fr); margin-top: 25rpx; text-align: center; } .stats text { display: block; color: #0c1f3d; font-size: 38rpx; font-weight: 800; } label { display: block; margin-top: 5rpx; color: #748197; font-size: 18rpx; } .setting { display: flex; align-items: center; justify-content: space-between; margin-top: 25rpx; padding-top: 20rpx; border-top: 1rpx solid #eef1f5; } .setting text { font-size: 23rpx; } .setting button { padding: 10rpx 17rpx; color: #2764c6; background: #eaf2ff; font-size: 20rpx; } .setting label { text-align: left; }
